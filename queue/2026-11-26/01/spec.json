  {
   "type": "code",
   "dur": 7.5,
   "title": "Oddiy dekorator",
   "desc": [
    "*args, **kwargs — istalgan argument"
   ],
   "code": [
    "def log(func):",
    "    def wrapper(*args, **kwargs):",
    "        print(\"chaqirildi:\", func.__name__)",
    "        return func(*args, **kwargs)",
    "    return wrapper",
    "",
    "@log",
    "def qosh(a, b):",
    "    return a + b",
    "",
    "print(qosh(2, 3))"
   ],
   "out_title": "Natija:",
   "out": [
    "~chaqirildi: qosh",
    "~5"
   ]
  },
  {
   "type": "code",
   "dur": 8,
   "title": "Amaliy: @vaqt",
   "desc": [
    "Funksiya kodiga tegmasdan"
   ],
   "code": [
    "import time",
    "from functools import wraps",
    "def vaqt(func):",
    "    @wraps(func)",
    "    def wrapper(*args, **kwargs):",
    "        t = time.perf_counter()",
    "        natija = func(*args, **kwargs)",
    "        s = time.perf_counter() - t",
    "        print(f\"{func.__name__}: {s:.2f} s\")",
    "        return natija",
    "    return wrapper",
    "@vaqt",
    "def hisobot(): time.sleep(1.2)",
    "hisobot()"
   ],
   "out_title": "Natija (taxminan):",
   "out": [
    "~hisobot: 1.20 s"
   ]
