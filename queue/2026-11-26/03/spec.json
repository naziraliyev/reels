   "code": [
    "from contextlib import contextmanager",
    "",
    "@contextmanager",
    "def tranzaksiya(db):",
    "    try:",
    "        yield db        # blok shu yerda",
    "        db.commit()",
    "    except Exception:",
    "        db.rollback()   # hammasi bekor",
    "        raise",
    "",
    "with tranzaksiya(db):",
    "    pul_ayir(db, 1, 100)",
    "    pul_qosh(db, 2, 100)  # xato!"
   ],
