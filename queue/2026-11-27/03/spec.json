  {
   "type": "code",
   "dur": 7.5,
   "title": "Oddiy class muammosi",
   "desc": [
    "== standartda id'ni solishtiradi (is kabi)"
   ],
   "code": [
    "class Talaba:",
    "    def __init__(self, ism, ball):",
    "        self.ism, self.ball = ism, ball",
    "",
    "t = Talaba(\"Ali\", 90)",
    "print(t)",
    "print(t == Talaba(\"Ali\", 90))"
   ],
   "out_title": "Natija:",
   "out": [
    "~<__main__.Talaba object at 0x7f9d...>",
    "!False"
   ]
  },
  {
   "type": "code",
   "dur": 7.5,
   "title": "@dataclass yechimi",
   "desc": [
    "Annotatsiyalardan __init__, __repr__,",
    "__eq__ ni class yaratilganda o'zi yozadi"
   ],
   "code": [
    "from dataclasses import dataclass",
    "",
    "@dataclass",
    "class Talaba:",
    "    ism: str",
    "    ball: int = 0",
    "",
    "t = Talaba(\"Ali\", 90)",
    "print(t)",
    "print(t == Talaba(\"Ali\", 90))",
    "print(Talaba(\"Vali\"))"
   ],
   "out_title": "Natija:",
   "out": [
    "~Talaba(ism='Ali', ball=90)",
    "~True",
    "~Talaba(ism='Vali', ball=0)"
   ]
  },
  {
   "type": "code",
   "dur": 7.5,
   "title": "Amaliy: order + frozen",
   "desc": [
    "order: maydon tartibida (narx, keyin nom)"
   ],
   "code": [
    "@dataclass(order=True, frozen=True)",
    "class Mahsulot:",
    "    narx: int",
    "    nom: str",
    "",
    "m = [Mahsulot(9000, \"sut\"),",
    "     Mahsulot(3000, \"non\")]",
    "print(sorted(m)[0])",
    "",
    "m[0].narx = 1"
   ],
   "out_title": "Natija:",
   "out": [
    "~Mahsulot(narx=3000, nom='non')",
    "!FrozenInstanceError: cannot assign",
    "!to field 'narx'"
   ]
  },
