   "type": "code",
   "dur": 8,
   "title": "O'z Exception klassi",
   "desc": [
    "Ma'lumot xato ichida keladi"
   ],
   "code": [
    "class BalansXato(Exception):",
    "    def __init__(self, kerak, bor):",
    "        self.kerak, self.bor = kerak, bor",
    "        super().__init__(f\"{kerak} > {bor}\")",
    "",
    "def yech(balans, summa):",
    "    if summa > balans:",
    "        raise BalansXato(summa, balans)",
    "    return balans - summa",
    "",
    "try:",
    "    yech(50, 80)",
    "except BalansXato as e:",
    "    print(e, \"| yetmaydi:\", e.kerak - e.bor)"
   ],
   "out_title": "Natija:",
   "out": [
    "~80 > 50 | yetmaydi: 30"
   ]
  },
  {
   "type": "code",
   "dur": 8,
   "title": "raise ... from e",
   "desc": [
    "Yangi xato + asl sabab saqlanadi"
   ],
   "code": [
    "class ConfigXato(Exception):",
    "    pass",
    "",
    "def port_ol(cfg):",
    "    try:",
    "        return int(cfg[\"port\"])",
    "    except (KeyError, ValueError) as e:",
    "        raise ConfigXato(\"port xato\") from e",
    "",
    "port_ol({\"port\": \"80a\"})"
   ],
