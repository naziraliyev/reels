   "code": [
    "class Talaba {",
    "  final String ism;",
    "  final int yosh;",
    "  Talaba(this.ism, this.yosh);",
    "",
    "  Talaba.fromJson(Map<String, dynamic> j)",
    "      : ism = j['ism'],",
    "        yosh = j['yosh'];",
    "}",
    "",
    "var j = {'ism': 'Vali', 'yosh': 19};",
    "var t = Talaba.fromJson(j);",
    "print('${t.ism}, ${t.yosh} yosh');"
