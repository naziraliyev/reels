   "code": [
    "class Xodim {",
    "  final String ism;",
    "  Xodim(this.ism);",
    "  String info() => 'Xodim: $ism';",
    "}",
    "class Menejer extends Xodim {",
    "  Menejer(super.ism);",
    "  @override",
    "  String info() => '${super.info()} (boss)';",
    "}",
    "void main() {",
    "  var x = [Xodim('Ali'), Menejer('Vali')];",
    "  for (var e in x) print(e.info());",
    "}"
   ],
   "out_title": "Natija:",
   "out": [
    "~Xodim: Ali",
    "~Xodim: Vali (boss)"
   ]
